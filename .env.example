### Search Providers (choose one) ###
# Option 1: Serper API (Google search results)
# SERPER_API_KEY=your-serper-api-key
# SERPER_API_URL=https://google.serper.dev/search
# SERPER_LOCATION=us
# SERPER_TIMEOUT=10

# Option 2: SearXNG (self-hosted search engine)
# SEARXNG_INSTANCE_URL=http://searxng:8080
# SEARXNG_API_KEY=your-searxng-api-key  # Optional
# SEARXNG_LOCATION=all
# SEARXNG_TIMEOUT=10

### Rerankers ###
# Option 1: Jina AI (cloud-based reranker, requires API key)
JINA_API_KEY=your-jina-api-key
# JINA_MODEL=jina-embeddings-v3

# Option 2: Infinity (self-hosted reranker)
# INFINITY_ENDPOINT=http://localhost:7997/embeddings
# INFINITY_MODEL=Alibaba-NLP/gte-Qwen2-7B-instruct

### Additional Tools ###
WOLFRAM_ALPHA_APP_ID=your-wolfram-alpha-app-id

### LLM Providers (via LiteLLM) ###
# OpenAI
OPENAI_API_KEY=your-openai-api-key
 # Optional, for custom endpoints
OPENAI_BASE_URL=your-openai-base-url

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter (recommended for accessing multiple models)
OPENROUTER_API_KEY=your-openrouter-api-key

# Fireworks AI
FIREWORKS_API_KEY=your-fireworks-api-key
GEMINI_API_KEY=your-gemini-api-key
# Azure OpenAI (if using Azure)
# AZURE_API_BASE=https://your-resource-name.openai.azure.com/
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_VERSION=2023-05-15

### Model Configuration ###
# Default model IDs for different tasks (via LiteLLM)
LITELLM_MODEL_ID=openrouter/google/gemini-2.0-flash-001
LITELLM_SEARCH_MODEL_ID=openrouter/google/gemini-2.0-flash-001
LITELLM_ORCHESTRATOR_MODEL_ID=openrouter/google/gemini-2.0-flash-001
LITELLM_EVAL_MODEL_ID=gpt-4o-mini

### LLM Generation Parameters ###
# Default parameters for LLM generation
# LLM_TEMPERATURE=0.2
# LLM_TOP_P=0.3

### Search Configuration ###
# Default search parameters
# MIN_SOURCES=2
# MAX_SOURCES=10
# PRO_MODE=false
# MAX_ITERATIONS=3
# MAX_SOURCES_PER_ITERATION=10

### Text Chunking Configuration ###
# Parameters for text chunking
# CHUNK_SIZE=150
# CHUNK_OVERLAP=50

### Source Processing Configuration ###
# Parameters for source processing
# TOP_RESULTS=5
# FILTER_CONTENT=true
